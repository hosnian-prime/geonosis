---
---

<button
  id="theme-toggle"
  aria-label="Toggle theme"
  class="relative w-9 h-9 flex items-center justify-center rounded-md border border-border hover:border-accent/40 transition-colors duration-200 cursor-pointer"
>
  <!-- Sun icon (shown in dark mode — click to switch to light) -->
  <svg
    id="icon-sun"
    class="absolute w-4 h-4 transition-all duration-300"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="12" cy="12" r="5" />
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
  </svg>
  <!-- Moon icon (shown in light mode — click to switch to dark) -->
  <svg
    id="icon-moon"
    class="absolute w-4 h-4 transition-all duration-300"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle')!;
  const iconSun = document.getElementById('icon-sun')!;
  const iconMoon = document.getElementById('icon-moon')!;

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    // In dark mode: show sun (to switch to light)
    // In light mode: show moon (to switch to dark)
    if (isDark) {
      iconSun.style.opacity = '1';
      iconSun.style.transform = 'rotate(0deg) scale(1)';
      iconMoon.style.opacity = '0';
      iconMoon.style.transform = 'rotate(90deg) scale(0)';
    } else {
      iconSun.style.opacity = '0';
      iconSun.style.transform = 'rotate(-90deg) scale(0)';
      iconMoon.style.opacity = '1';
      iconMoon.style.transform = 'rotate(0deg) scale(1)';
    }
  }

  // Initial state
  updateIcons();

  btn.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.contains('dark');

    html.classList.remove('dark', 'light');
    html.classList.add(isDark ? 'light' : 'dark');
    localStorage.setItem('theme', isDark ? 'light' : 'dark');

    updateIcons();
  });
</script>
