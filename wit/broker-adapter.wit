// `geonosis:broker-adapter@0.1.0` — per-IdP vendor quirks (Google's
// extra claims, GitHub's non-OIDC userinfo, Apple's form_post + private
// relay, etc). First-party adapters under `geonosis-broker` register
// against this interface so operators can replace them or stack extras.
// Dispatch mode: NamedSelect.

package geonosis:broker-adapter@0.1.0;

interface broker-adapter {
    use geonosis:types/types@0.1.0.{provider-info, plugin-error, claim-set};

    /// Realm-bound IdP configuration. Wire shape is bincode-encoded
    /// `geonosis_broker::IdpConfig`.
    type idp-config = list<u8>;

    /// Authentication request the host wants the user-agent redirected
    /// to. `state` and `nonce` are pre-generated by the host so the
    /// callback bridge can correlate without trusting the adapter.
    record authn-request {
        realm: string,
        idp-alias: string,
        redirect-uri: string,
        state: string,
        nonce: option<string>,
        scopes: list<string>,
        pkce-challenge: option<string>,
    }

    /// Raw inbound callback — either query-string params (redirect
    /// response_mode) or a form_post body, both presented as
    /// percent-decoded key/value pairs.
    record raw-callback {
        params: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    /// Normalized assertion the adapter emits after parsing the
    /// vendor's callback. `subject` is the external identifier the
    /// broker links to the local user.
    record broker-assertion {
        subject: string,
        idp-alias: string,
        attributes: list<tuple<string, string>>,
        raw-claims: claim-set,
        issued-at: u64,
        expires-at: option<u64>,
    }

    describe: func() -> provider-info;

    /// Build the URL to redirect the user-agent to.
    build-authn-url: func(
        req: authn-request,
        config: idp-config,
    ) -> result<string, plugin-error>;

    /// Parse the inbound callback into a normalized raw assertion.
    parse-callback: func(
        raw: raw-callback,
        config: idp-config,
    ) -> result<broker-assertion, plugin-error>;

    /// Validate signatures, audience, nonce, freshness. The host also
    /// enforces top-level invariants; this is the adapter's view.
    validate-assertion: func(
        assertion: broker-assertion,
        config: idp-config,
    ) -> result<broker-assertion, plugin-error>;

    /// Optional enrichment: pull `/user`-style endpoints and merge
    /// the result into a final claim set the broker pipeline consumes.
    enrich-claims: func(
        assertion: broker-assertion,
        config: idp-config,
    ) -> result<claim-set, plugin-error>;
}

world broker-adapter-provider {
    import geonosis:host/logging@0.1.0;
    import geonosis:host/secrets@0.1.0;
    import geonosis:host/http-client@0.1.0;
    export broker-adapter;
}
